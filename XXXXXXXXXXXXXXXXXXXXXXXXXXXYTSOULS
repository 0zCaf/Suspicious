local function Unsit(currentWeld)
if not sitting then return end
sitting = false
if currentWeld and currentWeld.Parent then
	currentWeld.Enabled = false
	currentWeld:Destroy()
	currentWeld = nil
end
if jumpConnection then
		jumpConnection:Disconnect()
		jumpConnection = nil
end
