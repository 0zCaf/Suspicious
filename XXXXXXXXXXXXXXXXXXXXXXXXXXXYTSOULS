local function SitOnSeat(seat)
	if sitting or cooldown then return end
	if not seat or not seat:IsDescendantOf(workspace) then return end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	sitting = true
	character:MoveTo(seat.Position)
	task.wait(0.04)
	humanoid.Sit = true
	humanoid.Jump = false
	root.CFrame = seat.CFrame * CFrame.new(0, 1.56732728992, 0)
	currentWeld = Instance.new("WeldConstraint")
	currentWeld.Part0 = seat
	currentWeld.Part1 = root
	currentWeld.Parent = seat
	jumpConnection = humanoid.Jumping:Connect(function(jumping)
		if jumping then
			Unsit(currentWeld)
		end
	end)
end
